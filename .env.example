# --- required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Public base URL (used for OIDC callbacks, push links, secure cookies)
PUBLIC_URL=https://queue.example.com
# 32 random bytes, base64:  openssl rand -base64 32   (BACK IT UP – encrypts provider credentials)
MASTER_KEY=
# Host path for workspaces/snapshots (must be identical inside/outside the container)
DATA_PATH=/srv/queued

# --- general ----------------------------------------------------------------
ALLOW_REGISTRATION=true
TASK_TIMEOUT_MIN=60
VERIFY_TIMEOUT_MIN=15
# Pause when a usage limit is hit but no reset time can be parsed
LIMIT_FALLBACK_MIN=60
# Agent sandbox resources
DOCKER_MEMORY=4g
DOCKER_CPUS=2
# DOCKER_NETWORK=bridge
# ENABLE_MOCK_PROVIDER=false

# --- web push (optional; generated in DATA_DIR if empty) ----------------------
VAPID_SUBJECT=mailto:you@example.com
# VAPID_PRIVATE_KEY=

# --- cloudflare tunnel (optional, `--profile tunnel`) -------------------------
# CLOUDFLARE_TUNNEL_TOKEN=

# --- login providers (OIDC / OAuth2) -----------------------------------------
# Callback URL to register at each IdP:  ${PUBLIC_URL}/api/auth/oidc/<id>/callback
# OIDC_PROVIDERS=google,apple,github
#
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
#
# Apple: Services ID as client id, key from "Sign in with Apple" (.p8)
# OIDC_APPLE_CLIENT_ID=com.example.queue.web
# OIDC_APPLE_TEAM_ID=
# OIDC_APPLE_KEY_ID=
# OIDC_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=
#
# Any OIDC IdP (Keycloak, Authentik, Entra ID, Zitadel …) via discovery:
# OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/main
# OIDC_KEYCLOAK_CLIENT_ID=
# OIDC_KEYCLOAK_CLIENT_SECRET=
# OIDC_KEYCLOAK_NAME=Firmen-SSO
