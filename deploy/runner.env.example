# /etc/queued/runner.env  (chmod 600, owner queued)
RUNNER_BIND=127.0.0.1:8090
RUNNER_TOKEN=
RUNNER_DATA_DIR=/var/lib/queued/runner
# podman (rootless, recommended) | docker (container runs as runner uid) | none (dev only)
RUNNER_ENGINE=podman
RUNNER_IMAGE=localhost/queued-agent:latest
RUNNER_MEMORY=4g
RUNNER_CPUS=2
# Network (WP02): containers always run with --network none; the only way out
# is the per-run egress proxy (allowlist per project, Projekt → Umgebung).
# Internal hosts agents may reach (LAN registry, self-hosted model server):
# RUNNER_EGRESS_PRIVATE_HOSTS=gpu.lan,10.0.0.5
# Extra blocked networks (CIDR), e.g. other servers of your network:
# RUNNER_EGRESS_DENY=192.0.2.0/24
# Extra root certificates for read-only inspection of HTTPS (PEM file):
# RUNNER_EGRESS_EXTRA_CA=/etc/queued/internal-ca.pem
# RUNNER_DATA_DIR must be at most 80 bytes long (Unix socket path limit).
# SELinux hosts (Fedora/RHEL): relabel bind mounts
# RUNNER_VOLUME_OPTS=Z
# Cancel/timeout/stall: SIGINT first (the agent CLI finishes its turn and still
# reports usage), SIGKILL / container removal after this grace period (max 60).
RUNNER_KILL_GRACE_SECS=15
