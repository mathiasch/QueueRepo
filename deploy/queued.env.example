# /etc/queued/queued.env  (chmod 600, owner queued)
DATABASE_URL=postgres://queued:CHANGE_ME@127.0.0.1:5432/queued
PUBLIC_URL=https://queue.example.com
BIND=127.0.0.1:8080
DATA_DIR=/var/lib/queued/app
FRONTEND_DIR=/opt/queued/web
# openssl rand -base64 32  – encrypts provider credentials and git tokens. BACK IT UP.
MASTER_KEY=
RUNNER_URL=http://127.0.0.1:8090
# must match runner.env
RUNNER_TOKEN=
ALLOW_REGISTRATION=true
# Default runtime limit per agent run (projects/tasks can override it in seconds)
TASK_TIMEOUT_MIN=60
VERIFY_TIMEOUT_MIN=15
# Stop a run after this many minutes without any output (0 = off). Large on
# purpose: agents stream nothing while a long tool call (e.g. a build) runs.
STALL_TIMEOUT_MIN=20
# Transient provider/infra/stall failures: re-queue with exponential backoff
# (base * 2^(n-1), capped) without using a fix attempt; blocked after N retries.
TRANSIENT_MAX_RETRIES=5
TRANSIENT_BACKOFF_BASE_SECS=30
TRANSIENT_BACKOFF_MAX_SECS=900
# WP13: poll interval of plan/review/analysis jobs (direct calls and provider batches).
BATCH_POLL_SECS=60
# WP09: Speicherplatz für Anhänge pro Person (MiB; Dateien bis 10 MiB, 10 pro Auftrag).
ATTACHMENT_QUOTA_MB=200
# The app itself calls model APIs for plan/review/analysis, connection checks
# and LiteLLM keys. Loopback and private networks are refused (SSRF guard);
# set to true only for self-hosted models (vLLM/Ollama) in your own network.
# Link-local/metadata addresses and the runner are always refused.
ALLOW_PRIVATE_LLM_ENDPOINTS=false
# WP05: poll interval of pull requests (CI, comments, state) in seconds.
PR_POLL_SECS=60
# WP05: git host APIs (GitHub/GitLab/Gitea) in loopback/private networks,
# e.g. a self-hosted Gitea in the LAN (also allows http:// API addresses).
ALLOW_PRIVATE_GIT_HOSTS=false
VAPID_SUBJECT=mailto:you@example.com
# Login providers – callback: ${PUBLIC_URL}/api/auth/oidc/<id>/callback
# OIDC_PROVIDERS=google,apple,github
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_APPLE_CLIENT_ID=com.example.queue.web
# OIDC_APPLE_TEAM_ID=
# OIDC_APPLE_KEY_ID=
# OIDC_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=
# OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/main
# OIDC_KEYCLOAK_CLIENT_ID=
# OIDC_KEYCLOAK_CLIENT_SECRET=

# --- WP10: Monitoring, Traces, Benachrichtigungen ---------------------------
# Prometheus /metrics. Empfohlen: eigener Listener nur auf Loopback (über den
# Cloudflare-Tunnel nicht erreichbar). Eine Nicht-Loopback-Adresse verlangt
# zusätzlich METRICS_TOKEN. Ohne beides gibt es kein /metrics (404).
# METRICS_BIND=127.0.0.1:9464
# Alternativ/zusätzlich: Bearer-Token (mind. 24 Zeichen), dann ist /metrics auf
# dem Haupt-Listener (BIND) nur mit `Authorization: Bearer <Token>` lesbar.
# METRICS_TOKEN=
# OpenTelemetry-Traces (OTLP/HTTP mit JSON). Ohne Endpunkt: aus, kein Overhead.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<collector-key>
# OTEL_SERVICE_NAME=queued
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# Benachrichtigungen: Takt der Zustellschleife (Sekunden) und ntfy/Webhook-Ziele
# im eigenen Netz (z. B. ntfy im LAN). Standard: nur öffentliche Adressen.
NOTIFY_TICK_SECS=15
ALLOW_PRIVATE_NOTIFY_TARGETS=false
# Verbrauchsdaten für die Auswertung (Tage, mindestens 35).
USAGE_RETENTION_DAYS=400

# --- WP11: runner fleet, backups, audit -------------------------------------
# Heartbeat to every runner; a runner without answer for RUNNER_LEASE_SECS is
# offline (its runs are re-queued, the runner stops them itself). Lease ≥ 3×
# heartbeat, 5–600 s.
# RUNNER_HEARTBEAT_SECS=5
# RUNNER_LEASE_SECS=30
# Backups (`queued backup`, see queued-backup.timer): key file with 32 random
# bytes (create: `queued backup-key /etc/queued/backup.key`), never MASTER_KEY.
BACKUP_KEY_FILE=/etc/queued/backup.key
# BACKUP_DIR=/var/backups/queued
# BACKUP_KEEP=14
# Audit log retention in days (at least 365; the database refuses less).
# AUDIT_RETENTION_DAYS=730

# --- WP12: live preview -------------------------------------------------------
# Own origin for live previews of tasks: every preview gets a random subdomain
# (wildcard DNS + certificate to this app; better a registrable domain of its
# own, not below the app's). Without it: screenshots only.
# PREVIEW_ORIGIN=https://*.preview.example.com
