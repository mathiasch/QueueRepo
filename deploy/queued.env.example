# /etc/queued/queued.env  (chmod 600, owner queued)
DATABASE_URL=postgres://queued:CHANGE_ME@127.0.0.1:5432/queued
PUBLIC_URL=https://queue.example.com
BIND=127.0.0.1:8080
DATA_DIR=/var/lib/queued/app
FRONTEND_DIR=/opt/queued/web
# openssl rand -base64 32  – encrypts provider credentials and git tokens. BACK IT UP.
MASTER_KEY=
RUNNER_URL=http://127.0.0.1:8090
# must match runner.env
RUNNER_TOKEN=
ALLOW_REGISTRATION=true
TASK_TIMEOUT_MIN=60
VERIFY_TIMEOUT_MIN=15
VAPID_SUBJECT=mailto:you@example.com
# Login providers – callback: ${PUBLIC_URL}/api/auth/oidc/<id>/callback
# OIDC_PROVIDERS=google,apple,github
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_APPLE_CLIENT_ID=com.example.queue.web
# OIDC_APPLE_TEAM_ID=
# OIDC_APPLE_KEY_ID=
# OIDC_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=
# OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/main
# OIDC_KEYCLOAK_CLIENT_ID=
# OIDC_KEYCLOAK_CLIENT_SECRET=
